rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function eDono(uid) {
      return estaLogado() && request.auth.uid == uid;
    }

    function perfilDoUsuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function temPerfilAtivo() {
      return estaLogado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && perfilDoUsuario().active == true;
    }

    function eSuporte() {
      return temPerfilAtivo() && perfilDoUsuario().role == 'support';
    }

    function statusValido(status) {
      return status in ['open', 'in_progress', 'waiting_requester', 'resolved', 'cancelled'];
    }

    function prioridadeValida(priority) {
      return priority in ['low', 'medium', 'high', 'urgent'];
    }

    function camposUsuarioObrigatorios() {
      return request.resource.data.keys().hasAll([
        'uid',
        'name',
        'email',
        'role',
        'department',
        'active',
        'createdAt',
        'updatedAt'
      ]);
    }

    function camposUsuarioPermitidos() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'role',
        'department',
        'active',
        'createdAt',
        'updatedAt'
      ]);
    }

    function usuarioValido(userId) {
      return camposUsuarioObrigatorios()
        && camposUsuarioPermitidos()
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.role in ['requester', 'support']
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function camposTicketObrigatorios() {
      return request.resource.data.keys().hasAll([
        'id',
        'title',
        'description',
        'category',
        'priority',
        'status',
        'location',
        'requesterId',
        'requesterName',
        'requesterEmail',
        'sessionId',
        'sessionSupportId',
        'lastMessageAt',
        'lastMessageBy',
        'assignedToId',
        'assignedToName',
        'supportResponse',
        'resolution',
        'createdAt',
        'updatedAt',
        'resolvedAt',
        'cancelledAt'
      ]);
    }

    function camposTicketPermitidos() {
      return request.resource.data.keys().hasOnly([
        'id',
        'title',
        'description',
        'category',
        'priority',
        'status',
        'location',
        'requesterId',
        'requesterName',
        'requesterEmail',
        'sessionId',
        'sessionSupportId',
        'lastMessageAt',
        'lastMessageBy',
        'assignedToId',
        'assignedToName',
        'supportResponse',
        'resolution',
        'createdAt',
        'updatedAt',
        'resolvedAt',
        'cancelledAt'
      ]);
    }

    function camposSessaoPermitidos() {
      return request.resource.data.keys().hasOnly([
        'codigo',
        'suporteId',
        'suporteNome',
        'ativo',
        'criadoEm'
      ]);
    }

    // Confere que a sessao informada no ticket existe, esta ativa e pertence ao
    // suporte declarado em `sessionSupportId` (impede forjar o vinculo).
    function sessaoDoTicketValida() {
      return exists(/databases/$(database)/documents/sessoes/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessoes/$(request.resource.data.sessionId)).data.suporteId == request.resource.data.sessionSupportId
        && get(/databases/$(database)/documents/sessoes/$(request.resource.data.sessionId)).data.ativo == true;
    }

    function ticketBaseValido(ticketId) {
      return camposTicketObrigatorios()
        && camposTicketPermitidos()
        && request.resource.data.id == ticketId
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.category is string
        && request.resource.data.priority is string
        && request.resource.data.status is string
        && request.resource.data.location is string
        && request.resource.data.requesterId is string
        && request.resource.data.requesterName is string
        && request.resource.data.requesterEmail is string
        && request.resource.data.sessionId is string
        && request.resource.data.sessionSupportId is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && prioridadeValida(request.resource.data.priority)
        && statusValido(request.resource.data.status);
    }

    function camposEditaveisPeloSolicitante() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'category',
        'priority',
        'location',
        'status',
        'updatedAt',
        'cancelledAt'
      ]);
    }

    function camposEditaveisPeloSuporte() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'assignedToId',
        'assignedToName',
        'supportResponse',
        'resolution',
        'updatedAt',
        'resolvedAt',
        'cancelledAt'
      ]);
    }

    match /users/{userId} {
      allow read: if eDono(userId) || eSuporte();

      allow create: if eDono(userId)
        && usuarioValido(userId)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true;

      allow update: if eDono(userId)
        && usuarioValido(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'department',
          'updatedAt'
        ]);

      // Autoexclusao de conta (opcao A): o proprio usuario pode apagar seu
      // documento de perfil. Outros usuarios e o suporte nao apagam perfis
      // alheios. A exclusao da conta no Authentication e feita pelo cliente.
      allow delete: if eDono(userId);
    }

    match /tickets/{ticketId} {
      // Suporte le apenas os chamados das proprias sessoes (escopo por
      // `sessionSupportId`); o solicitante le os proprios.
      allow read: if (eSuporte() && resource.data.sessionSupportId == request.auth.uid)
        || (estaLogado() && resource.data.requesterId == request.auth.uid);

      allow create: if estaLogado()
        && ticketBaseValido(ticketId)
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && sessaoDoTicketValida()
        && request.resource.data.status == 'open'
        && request.resource.data.assignedToId == null
        && request.resource.data.assignedToName == null
        && request.resource.data.supportResponse == null
        && request.resource.data.resolution == null
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastMessageBy == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.cancelledAt == null;

      allow update: if estaLogado()
        && ticketBaseValido(ticketId)
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'open'
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterEmail == resource.data.requesterEmail
        && request.resource.data.requesterName == resource.data.requesterName
        && request.resource.data.assignedToId == resource.data.assignedToId
        && request.resource.data.assignedToName == resource.data.assignedToName
        && request.resource.data.supportResponse == resource.data.supportResponse
        && request.resource.data.resolution == resource.data.resolution
        && request.resource.data.resolvedAt == resource.data.resolvedAt
        && request.resource.data.status in ['open', 'cancelled']
        && camposEditaveisPeloSolicitante();

      allow update: if eSuporte()
        && ticketBaseValido(ticketId)
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.requesterEmail == resource.data.requesterEmail
        && request.resource.data.requesterName == resource.data.requesterName
        && request.resource.data.title == resource.data.title
        && request.resource.data.description == resource.data.description
        && request.resource.data.category == resource.data.category
        && request.resource.data.priority == resource.data.priority
        && request.resource.data.location == resource.data.location
        && request.resource.data.createdAt == resource.data.createdAt
        && camposEditaveisPeloSuporte();

      // Marcadores de ultima mensagem do chat: qualquer parte do chamado pode
      // atualizar SO esses dois campos (independe do status). O `lastMessageBy`
      // tem de bater com o lado de quem escreve (evita forjar a origem).
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt', 'lastMessageBy'])
        && request.resource.data.lastMessageAt is timestamp
        && (
          (estaLogado()
            && resource.data.requesterId == request.auth.uid
            && request.resource.data.lastMessageBy == 'requester')
          || (eSuporte()
            && resource.data.sessionSupportId == request.auth.uid
            && request.resource.data.lastMessageBy == 'support')
        );

      // Delete escopado: o suporte so apaga chamados das PROPRIAS sessoes
      // (mesmo escopo do read, linha do allow read acima). O solicitante apaga
      // apenas os proprios chamados ainda abertos (RN005/RN006).
      allow delete: if (eSuporte() && resource.data.sessionSupportId == request.auth.uid)
        || (estaLogado()
          && resource.data.requesterId == request.auth.uid
          && resource.data.status == 'open');

      match /historico/{historicoId} {
        function ticketPaiHist() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
        }
        function eSolicitanteHist() {
          return estaLogado() && ticketPaiHist().requesterId == request.auth.uid;
        }
        function eSuporteHist() {
          return eSuporte() && ticketPaiHist().sessionSupportId == request.auth.uid;
        }

        allow read: if eSolicitanteHist() || eSuporteHist();

        // Trilha de auditoria gravada pelo cliente (plano Spark, sem Functions).
        // So as partes do chamado criam; eventos sao imutaveis. O autor tem de
        // ser o proprio usuario.
        allow create: if (eSolicitanteHist() || eSuporteHist())
          && request.resource.data.keys().hasOnly([
            'acao', 'statusAnterior', 'statusNovo', 'autorId', 'autorNome', 'criadoEm'
          ])
          && request.resource.data.acao is string
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.criadoEm is timestamp;

        allow update, delete: if false;
      }

      // Chat do chamado: conversa entre o solicitante dono e o suporte da sessao.
      match /mensagens/{mensagemId} {
        function ticketPai() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data;
        }
        function eSolicitanteDoTicket() {
          return estaLogado() && ticketPai().requesterId == request.auth.uid;
        }
        function eSuporteDoTicket() {
          return eSuporte() && ticketPai().sessionSupportId == request.auth.uid;
        }

        allow read: if eSolicitanteDoTicket() || eSuporteDoTicket();

        // Mensagens sao imutaveis: apenas create, sem update/delete. O autor tem
        // de ser o proprio usuario e o papel coerente com o lado do chamado.
        allow create: if (eSolicitanteDoTicket() || eSuporteDoTicket())
          && request.resource.data.keys().hasOnly([
            'autorId', 'autorNome', 'autorPapel', 'texto', 'criadoEm'
          ])
          && request.resource.data.autorId == request.auth.uid
          && request.resource.data.autorNome is string
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 2000
          && request.resource.data.criadoEm is timestamp
          && (
            (eSolicitanteDoTicket() && request.resource.data.autorPapel == 'requester')
            || (eSuporteDoTicket() && request.resource.data.autorPapel == 'support')
          );

        allow update, delete: if false;
      }
    }

    match /sessoes/{codigo} {
      // Qualquer usuario logado pode LER uma sessao pelo codigo (necessario para
      // o solicitante validar o codigo ao entrar). O codigo e um identificador
      // de pareamento, nao um segredo; o escopo real dos dados fica nos tickets.
      allow read: if estaLogado();

      // Apenas o suporte cria a propria sessao (suporteId = ele mesmo, ativa).
      allow create: if eSuporte()
        && camposSessaoPermitidos()
        && request.resource.data.codigo == codigo
        && request.resource.data.suporteId == request.auth.uid
        && request.resource.data.suporteNome is string
        && request.resource.data.ativo == true
        && request.resource.data.criadoEm is timestamp;

      // O dono pode apenas alternar `ativo` (encerrar/reabrir a sessao).
      allow update: if eSuporte()
        && resource.data.suporteId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ativo']);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
